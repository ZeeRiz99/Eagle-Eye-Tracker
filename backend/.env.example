NODE_ENV=development
PORT=4000

# Postgres (PostGIS + TimescaleDB extensions enabled)
DATABASE_URL=postgres://eagleeye:eagleeye@localhost:5432/eagleeye

# Redis (Socket.io adapter, rate limiting, geofence cache)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Object storage (S3-compatible) for profile pictures + transient audio clips
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# WhatsApp Business API (via BSP e.g. Infobip/Gupshup)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SOS_TEMPLATE_NAME=sos_alert

# Voice call escalation (e.g. Twilio Voice or local telephony provider)
VOICE_API_ACCOUNT_SID=
VOICE_API_AUTH_TOKEN=
VOICE_API_FROM_NUMBER=

# Maps
MAPS_API_KEY=
